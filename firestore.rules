rules_version = '2';

// Ringer Fantasy security rules.
// EDIT the email below to the commissioner's email (same as COMMISSIONER_EMAILS in index.html).
service cloud.firestore {
  match /databases/{database}/documents {

    function isCommish() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email.lower() in ['you@example.com'];
    }

    // 'auto' locks at the first flight: Fri Dec 4 2026, 2:00 PM Central (20:00 UTC).
    function lockSetting() {
      return exists(/databases/$(database)/documents/league/state)
        ? get(/databases/$(database)/documents/league/state).data.get('lock', 'auto')
        : 'auto';
    }
    function lineupsOpen() {
      return lockSetting() == 'open'
        || (lockSetting() == 'auto' && request.time < timestamp.value(1796414400000));
    }

    function validTeam() {
      let d = request.resource.data;
      return d.keys().hasOnly(['name', 'picks', 'cap', 'owner', 'at'])
        && d.name is string && d.name.size() <= 40
        && d.owner is string && d.owner.size() <= 60
        && d.picks is list && d.picks.size() == 7;
    }

    // Anyone can see teams; each player can only write their own, and only before the lock.
    match /teams/{uid} {
      allow read: if true;
      allow create, update: if request.auth != null && request.auth.uid == uid
        && lineupsOpen() && validTeam();
      allow delete: if isCommish();
    }

    // Scores and the lock setting: everyone reads, only the commissioner writes.
    match /league/{docId} {
      allow read: if true;
      allow write: if isCommish();
    }

    // Trash-talk wall: everyone reads; signed-in players post as themselves (280 characters max);
    // the author or the commissioner can delete a post.
    match /posts/{postId} {
      allow read: if true;
      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly(['uid', 'name', 'team', 'text', 'at'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.text is string
        && request.resource.data.text.size() > 0 && request.resource.data.text.size() <= 280
        && request.resource.data.name is string && request.resource.data.name.size() <= 60
        && request.resource.data.team is string && request.resource.data.team.size() <= 40
        && request.resource.data.at == request.time;
      allow delete: if isCommish()
        || (request.auth != null && resource.data.uid == request.auth.uid);
    }

    // Private contact list: each player's email, saved under their own account.
    // ONLY the commissioner can read it. A player can only save their own real sign-in email.
    match /contacts/{uid} {
      allow read: if isCommish();
      allow create, update: if request.auth != null && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['email', 'name', 'team', 'at'])
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.name is string && request.resource.data.name.size() <= 60
        && request.resource.data.team is string && request.resource.data.team.size() <= 40;
      allow delete: if isCommish() || (request.auth != null && request.auth.uid == uid);
    }

    // Reactions (Bullseye / Ouch): one per player per post, saved as "<postId>_<uid>".
    match /reacts/{reactId} {
      allow read: if true;
      allow create, update: if request.auth != null
        && request.resource.data.keys().hasOnly(['uid', 'post', 'kind'])
        && request.resource.data.uid == request.auth.uid
        && reactId == request.resource.data.post + '_' + request.auth.uid
        && request.resource.data.kind in ['b', 'o'];
      allow delete: if isCommish()
        || (request.auth != null && resource.data.uid == request.auth.uid);
    }
  }
}
